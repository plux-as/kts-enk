{
  "expo": {
    "name": "KTS Alfa",
    "slug": "kts-alfa",
    "version": "2.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/insta-logo-new.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "ktsalfa",
    "splash": {
      "image": "./assets/images/insta-logo-new.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D1D1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pluxas.ktsalfa",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIUserInterfaceStyle": "Dark"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.plux.ktsalfa",
      "userInterfaceStyle": "dark",
      "jsEngine": "hermes",
      "autolinking": {
        "exclude": [
          "expo-glass-effect",
          "@bacons/apple-targets"
        ]
      }
    },
    "web": {
      "favicon": "./assets/images/cb4a90ce-1db4-45c1-8f2d-ee549a6461df.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withSecureStoreXml",
      "./plugins/withGradleProperties",
      "./plugins/withImagePickerFix",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "expo-router",
      "expo-image-picker",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D1D1E",
          "image": "./assets/images/insta-logo-new.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    },
    "notification": {
      "icon": "./assets/notification-icon.png"
    }
  }
}